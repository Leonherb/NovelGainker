{
  "name": "novelgainker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @novelgainker/desktop tauri dev",
    "format": "prettier --write package.json .prettierrc.json eslint.config.mjs \"scripts/**/*.mjs\" \"apps/desktop/src/**/*.{ts,tsx,css}\" apps/desktop/package.json apps/desktop/tsconfig.json apps/desktop/tsconfig.node.json apps/desktop/vite.config.ts apps/desktop/vitest.config.ts apps/desktop/src-tauri/tauri.conf.json \"apps/desktop/src-tauri/capabilities/*.json\"",
    "format:check": "prettier --check package.json .prettierrc.json eslint.config.mjs \"scripts/**/*.mjs\" \"apps/desktop/src/**/*.{ts,tsx,css}\" apps/desktop/package.json apps/desktop/tsconfig.json apps/desktop/tsconfig.node.json apps/desktop/vite.config.ts apps/desktop/vitest.config.ts apps/desktop/src-tauri/tauri.conf.json \"apps/desktop/src-tauri/capabilities/*.json\"",
    "lint": "eslint eslint.config.mjs scripts apps/desktop/src apps/desktop/*.ts --max-warnings 0",
    "typecheck": "pnpm --filter @novelgainker/desktop exec tsc --noEmit",
    "build:frontend": "pnpm --filter @novelgainker/desktop build",
    "build:test:debug": "pnpm --filter @novelgainker/desktop tauri build --debug --no-bundle",
    "build:test": "pnpm --filter @novelgainker/desktop tauri build --no-bundle",
    "test:frontend": "pnpm --filter @novelgainker/desktop test",
    "format:rust": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features --locked --offline -- -D warnings",
    "test:rust": "cargo test --workspace --locked --offline",
    "quality:boundaries": "node scripts/check-nr0-boundaries.mjs",
    "e2e:sprint1": "node scripts/sprint1-offline-e2e.mjs",
    "e2e:canon-kernel": "node scripts/canon-kernel-e2e.mjs",
    "e2e:nr001": "node scripts/nr001-retirement-baseline.mjs",
    "e2e:nr002": "node scripts/nr002-clean-slate-e2e.mjs",
    "e2e:nr003": "node scripts/nr003-conversation-store-e2e.mjs",
    "e2e:nr004": "node scripts/nr004-provider-conversation-e2e.mjs",
    "e2e:nr005": "node scripts/nr005-conversation-ui-close-e2e.mjs",
    "e2e:nr006": "node scripts/nr006-nrg1-e2e.mjs",
    "e2e:nr106": "node scripts/nr106-nrg2-e2e.mjs",
    "e2e:nr206": "node scripts/nr206-nrg3-e2e.mjs",
    "pack:nr301:write": "node scripts/nr301-pack-refresh.mjs --write",
    "pack:nr301:check": "node scripts/nr301-pack-refresh.mjs",
    "e2e:nr306": "node scripts/nr306-nrg4-e2e.mjs",
    "smoke:desktop:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile debug",
    "smoke:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile release -CaptureEvidence -EvidenceGate nr-g1",
    "quality": "node scripts/quality.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
