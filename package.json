{
  "name": "novelgainker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @novelgainker/desktop tauri dev",
    "format": "prettier --write package.json .prettierrc.json eslint.config.mjs \"scripts/**/*.mjs\" \"apps/desktop/src/**/*.{ts,tsx,css}\" apps/desktop/package.json apps/desktop/tsconfig.json apps/desktop/tsconfig.node.json apps/desktop/vite.config.ts apps/desktop/vitest.config.ts apps/desktop/src-tauri/tauri.conf.json \"apps/desktop/src-tauri/capabilities/*.json\"",
    "format:check": "prettier --check package.json .prettierrc.json eslint.config.mjs \"scripts/**/*.mjs\" \"apps/desktop/src/**/*.{ts,tsx,css}\" apps/desktop/package.json apps/desktop/tsconfig.json apps/desktop/tsconfig.node.json apps/desktop/vite.config.ts apps/desktop/vitest.config.ts apps/desktop/src-tauri/tauri.conf.json \"apps/desktop/src-tauri/capabilities/*.json\"",
    "lint": "eslint eslint.config.mjs scripts apps/desktop/src apps/desktop/*.ts --max-warnings 0",
    "typecheck": "pnpm --filter @novelgainker/desktop exec tsc --noEmit",
    "build:frontend": "pnpm --filter @novelgainker/desktop build",
    "build:test:debug": "pnpm --filter @novelgainker/desktop tauri build --debug --no-bundle",
    "build:test": "pnpm --filter @novelgainker/desktop tauri build --no-bundle",
    "test:frontend": "pnpm --filter @novelgainker/desktop test",
    "format:rust": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features --locked --offline -- -D warnings",
    "test:rust": "cargo test --workspace --locked --offline",
    "quality:boundaries": "node scripts/check-sprint0-boundaries.mjs",
    "skills:lock": "node scripts/agent-migration-skill-pack-lock.mjs --write",
    "skills:check": "node scripts/agent-migration-skill-pack-lock.mjs --check",
    "agent-contracts:lock": "node scripts/agent-migration-contract-lock.mjs --write",
    "agent-contracts:check": "node scripts/agent-migration-contract-lock.mjs --check",
    "agent-actions:lock": "node scripts/agent-migration-action-contract-lock.mjs --write",
    "agent-actions:check": "node scripts/agent-migration-action-contract-lock.mjs --check",
    "agent-governance:lock": "node scripts/agent-migration-governance-contract-lock.mjs --write",
    "agent-governance:check": "node scripts/agent-migration-governance-contract-lock.mjs --check",
    "agent-runtime:lock": "node scripts/agent-migration-am1-contract-lock.mjs --write",
    "agent-runtime:check": "node scripts/agent-migration-am1-contract-lock.mjs --check",
    "agent-write-runtime:lock": "node scripts/agent-migration-am2-contract-lock.mjs --write",
    "agent-write-runtime:check": "node scripts/agent-migration-am2-contract-lock.mjs --check",
    "e2e:sprint1": "node scripts/sprint1-offline-e2e.mjs",
    "e2e:sprint2": "node scripts/sprint2-security-e2e.mjs",
    "e2e:sprint3": "node scripts/sprint3-safe-apply-e2e.mjs",
    "e2e:ng401": "node scripts/sprint4-project-create-e2e.mjs",
    "e2e:ng402": "node scripts/sprint4-setting-create-e2e.mjs",
    "e2e:ng403": "node scripts/sprint4-material-create-e2e.mjs",
    "e2e:ng404": "node scripts/sprint4-plot-create-e2e.mjs",
    "e2e:ng405": "node scripts/sprint4-character-v2-e2e.mjs",
    "e2e:ng406": "node scripts/sprint4-router-e2e.mjs",
    "e2e:sprint4": "node --no-warnings scripts/sprint4-g4-e2e.mjs",
    "e2e:ng407": "node --no-warnings scripts/sprint4-g4-e2e.mjs",
    "e2e:ng501": "node scripts/sprint5-context-builder-e2e.mjs",
    "e2e:ng502": "node scripts/sprint5-reader-model-e2e.mjs",
    "e2e:ng503": "node scripts/sprint5-chapter-proposal-e2e.mjs",
    "e2e:ng504": "node scripts/sprint5-continuity-e2e.mjs",
    "e2e:ng505": "node scripts/sprint5-chapter-apply-e2e.mjs",
    "e2e:ng506": "node scripts/sprint5-lifecycle-ledger-e2e.mjs",
    "e2e:ng507": "node scripts/sprint5-g5-storytelling-e2e.mjs",
    "e2e:nga001": "node scripts/agent-migration-ng-a001-e2e.mjs",
    "e2e:nga002": "node scripts/agent-migration-ng-a002-e2e.mjs",
    "e2e:nga003": "node scripts/agent-migration-ng-a003-e2e.mjs",
    "e2e:nga004": "node scripts/agent-migration-ng-a004-e2e.mjs",
    "e2e:nga101": "node scripts/agent-migration-am1-e2e.mjs --story=ng-a101",
    "e2e:nga102": "node scripts/agent-migration-am1-e2e.mjs --story=ng-a102",
    "e2e:nga103": "node scripts/agent-migration-am1-e2e.mjs --story=ng-a103",
    "e2e:nga104": "node scripts/agent-migration-am1-e2e.mjs --story=ng-a104",
    "e2e:ga1": "node scripts/agent-migration-am1-e2e.mjs --story=ga1",
    "e2e:nga201": "node scripts/agent-migration-am2-e2e.mjs --story=ng-a201",
    "e2e:nga202": "node scripts/agent-migration-am2-e2e.mjs --story=ng-a202",
    "e2e:nga203": "node scripts/agent-migration-am2-e2e.mjs --story=ng-a203",
    "e2e:nga204": "node scripts/agent-migration-am2-e2e.mjs --story=ng-a204",
    "e2e:nga205": "node scripts/agent-migration-am2-e2e.mjs --story=ng-a205",
    "e2e:nga206": "node scripts/agent-migration-am2-e2e.mjs --story=ng-a206",
    "e2e:ga2": "node scripts/agent-migration-am2-e2e.mjs --story=ga2",
    "smoke:desktop:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile debug",
    "smoke:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile release -CaptureEvidence -EvidenceGate g2",
    "smoke:g3": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile release -CaptureEvidence -EvidenceGate g3",
    "smoke:g4": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile release -CaptureEvidence -EvidenceGate g4",
    "smoke:g5": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile release -CaptureEvidence -EvidenceGate g5",
    "smoke:ng301": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile release -CaptureEvidence -EvidenceGate ng301",
    "smoke:ng302": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile release -CaptureEvidence -EvidenceGate ng302",
    "smoke:ng303": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile release -CaptureEvidence -EvidenceGate ng303",
    "smoke:ng401": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1 -Profile release -CaptureEvidence -EvidenceGate ng401",
    "smoke:provider:live": "node scripts/sprint2-live-smoke.mjs",
    "quality:verify-gates": "node scripts/verify-quality-gates.mjs",
    "quality": "node scripts/quality.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
