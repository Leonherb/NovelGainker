{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window can call only current project lifecycle, scoped editing, local preferences, Provider credential operations, and window-close commands",
  "windows": ["main"],
  "permissions": [
    "allow-health-check",
    "allow-app-state-load",
    "allow-app-state-save-ui",
    "allow-conversation-session-load",
    "allow-conversation-turn-start",
    "allow-conversation-turn-cancel",
    "allow-provider-status-load",
    "allow-provider-key-save",
    "allow-provider-key-delete",
    "allow-provider-select",
    "allow-provider-connection-test",
    "allow-project-scan",
    "allow-project-create-preview",
    "allow-project-create",
    "allow-project-open",
    "allow-project-open-recent",
    "allow-project-list-files",
    "allow-project-read-file",
    "allow-app-state-set-current-file",
    "allow-project-watch-file",
    "allow-project-save-file",
    "allow-project-validate-draft",
    "allow-project-search",
    "allow-project-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
