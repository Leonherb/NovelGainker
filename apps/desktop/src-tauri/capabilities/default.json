{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window can call only health, a read-only built-in workflow catalog and Storytelling context/request/chapter-proposal/continuity/confirmed chapter-patch, lifecycle and Ledger operations, project lifecycle, scoped edit, validation, offline search, local preferences, Provider credential mutations, explicit selection, bounded Provider testing and chat, recovery, and window-close commands",
  "windows": ["main"],
  "permissions": [
    "allow-health-check",
    "allow-app-state-load",
    "allow-app-state-save-ui",
    "allow-workflow-registry-load",
    "allow-router-resolve-local",
    "allow-router-run-start",
    "allow-router-run-cancel",
    "allow-workflow-run-status-load",
    "allow-workflow-source-catalog",
    "allow-workflow-run-prepare",
    "allow-workflow-run-generate",
    "allow-workflow-proposal-apply",
    "allow-workflow-run-cancel",
    "allow-workflow-run-abandon",
    "allow-story-context-catalog",
    "allow-story-context-build",
    "allow-story-context-request-preview",
    "allow-story-chapter-generate-start",
    "allow-story-chapter-status-load",
    "allow-story-chapter-generate-cancel",
    "allow-story-continuity-check",
    "allow-story-continuity-status-load",
    "allow-story-continuity-warning-confirm",
    "allow-story-chapter-patch-preview",
    "allow-story-chapter-patch-status-load",
    "allow-story-chapter-patch-apply",
    "allow-story-chapter-state-preview",
    "allow-story-chapter-lifecycle-status-load",
    "allow-story-chapter-state-apply",
    "allow-story-ledger-update-preview",
    "allow-story-ledger-update-apply",
    "allow-provider-status-load",
    "allow-provider-key-save",
    "allow-provider-key-delete",
    "allow-provider-select",
    "allow-provider-connection-test",
    "allow-provider-chat-start",
    "allow-provider-chat-cancel",
    "allow-project-scan",
    "allow-project-create-preview",
    "allow-project-create",
    "allow-project-open",
    "allow-project-open-recent",
    "allow-project-list-files",
    "allow-project-read-file",
    "allow-app-state-set-current-file",
    "allow-project-watch-file",
    "allow-project-save-file",
    "allow-project-validate-draft",
    "allow-project-search",
    "allow-project-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close"
  ]
}
