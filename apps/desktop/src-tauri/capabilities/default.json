{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window can call only health, the GAR2 V2 Conversation-to-Canon Agent, project lifecycle and scoped offline editing, local preferences, Provider credential operations, and window-close commands",
  "windows": ["main"],
  "permissions": [
    "allow-health-check",
    "allow-app-state-load",
    "allow-app-state-save-ui",
    "allow-agent-skill-registry-load",
    "allow-agent-session-load",
    "allow-agent-turn-start",
    "allow-agent-turn-cancel",
    "allow-agent-session-clear",
    "allow-agent-memory-compact",
    "allow-agent-history-branch-resolve",
    "allow-agent-write-policy-set",
    "allow-agent-context-mark-upsert",
    "allow-agent-context-mark-remove",
    "allow-agent-conflict-resolution-submit",
    "allow-agent-write-confirmation-submit",
    "allow-agent-write-plan-reject",
    "allow-agent-write-undo-apply",
    "allow-provider-status-load",
    "allow-provider-key-save",
    "allow-provider-key-delete",
    "allow-provider-select",
    "allow-provider-connection-test",
    "allow-project-scan",
    "allow-project-create-preview",
    "allow-project-create",
    "allow-project-open",
    "allow-project-open-recent",
    "allow-project-list-files",
    "allow-project-read-file",
    "allow-app-state-set-current-file",
    "allow-project-watch-file",
    "allow-project-save-file",
    "allow-project-validate-draft",
    "allow-project-search",
    "allow-project-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
