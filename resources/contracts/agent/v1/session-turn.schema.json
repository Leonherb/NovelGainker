{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelgainker.local/schemas/agent/session-turn-v1.json",
  "title": "NovelGainker Project Agent Session and Turn V1",
  "oneOf": [
    { "$ref": "#/$defs/ProjectAgentSessionV1" },
    { "$ref": "#/$defs/AgentTurnV1" },
    { "$ref": "#/$defs/ProjectAgentBasePolicyV1" }
  ],
  "$defs": {
    "OpaqueProjectId": {
      "type": "string",
      "pattern": "^prj_[A-Za-z0-9_-]{8,92}$",
      "maxLength": 96
    },
    "OpaqueSessionId": {
      "type": "string",
      "pattern": "^ses_[A-Za-z0-9_-]{8,92}$",
      "maxLength": 96
    },
    "OpaqueTurnId": {
      "type": "string",
      "pattern": "^trn_[A-Za-z0-9_-]{8,92}$",
      "maxLength": 96
    },
    "OpaqueSummaryId": {
      "type": "string",
      "pattern": "^sum_[A-Za-z0-9_-]{8,92}$",
      "maxLength": 96
    },
    "BoundedToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ProviderSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "presetVersion", "modelId"],
      "properties": {
        "providerId": { "$ref": "#/$defs/BoundedToken" },
        "presetVersion": { "$ref": "#/$defs/BoundedToken" },
        "modelId": { "$ref": "#/$defs/BoundedToken" }
      }
    },
    "SkillPackSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "hash"],
      "properties": {
        "version": { "$ref": "#/$defs/BoundedToken" },
        "hash": { "$ref": "#/$defs/ContentHash" }
      }
    },
    "TurnBudgetV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAgentSteps",
        "maxToolCalls",
        "maxToolCallsPerBatch",
        "maxUniqueProjectFiles",
        "maxModifiedProjectFiles",
        "maxWriteTransactions",
        "maxProviderRequestBytes"
      ],
      "properties": {
        "maxAgentSteps": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxToolCalls": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxToolCallsPerBatch": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxUniqueProjectFiles": { "type": "integer", "minimum": 1, "maximum": 24 },
        "maxModifiedProjectFiles": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxWriteTransactions": { "const": 1 },
        "maxProviderRequestBytes": { "type": "integer", "minimum": 1, "maximum": 98304 }
      }
    },
    "FrozenTurnSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "skillPack", "authorizationPolicy", "userRequestHash", "budget"],
      "properties": {
        "provider": { "$ref": "#/$defs/ProviderSnapshotV1" },
        "skillPack": { "$ref": "#/$defs/SkillPackSnapshotV1" },
        "authorizationPolicy": {
          "enum": ["plan_only", "review_every_write", "auto_apply_safe"]
        },
        "userRequestHash": { "$ref": "#/$defs/ContentHash" },
        "budget": { "$ref": "#/$defs/TurnBudgetV1" }
      }
    },
    "SessionSummaryRefV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "summaryId", "version", "contentHash", "utf8Bytes"],
      "properties": {
        "projectId": { "$ref": "#/$defs/OpaqueProjectId" },
        "summaryId": { "$ref": "#/$defs/OpaqueSummaryId" },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "#/$defs/ContentHash" },
        "utf8Bytes": { "type": "integer", "minimum": 0, "maximum": 32768 }
      }
    },
    "TurnIndexEntryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "turnId", "state", "updatedAtMs"],
      "properties": {
        "projectId": { "$ref": "#/$defs/OpaqueProjectId" },
        "turnId": { "$ref": "#/$defs/OpaqueTurnId" },
        "state": {
          "enum": ["completed", "cancelled", "failed", "recovery_required"]
        },
        "updatedAtMs": { "type": "integer", "minimum": 0 }
      }
    },
    "WriterLeaseV1": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "released" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "turnId"],
          "properties": {
            "status": { "const": "held" },
            "turnId": { "$ref": "#/$defs/OpaqueTurnId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "turnId"],
          "properties": {
            "status": { "const": "recovery_required" },
            "turnId": { "$ref": "#/$defs/OpaqueTurnId" }
          }
        }
      ]
    },
    "ProjectAgentSessionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sessionId",
        "projectId",
        "status",
        "provider",
        "skillPack",
        "authorizationPolicy",
        "summary",
        "recentTurns",
        "activeTurnId",
        "writerLease",
        "createdAtMs",
        "updatedAtMs",
        "terminationReason"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "sessionId": { "$ref": "#/$defs/OpaqueSessionId" },
        "projectId": { "$ref": "#/$defs/OpaqueProjectId" },
        "status": { "enum": ["active", "recovery_required", "terminated"] },
        "provider": { "$ref": "#/$defs/ProviderSnapshotV1" },
        "skillPack": { "$ref": "#/$defs/SkillPackSnapshotV1" },
        "authorizationPolicy": {
          "enum": ["plan_only", "review_every_write", "auto_apply_safe"]
        },
        "summary": {
          "oneOf": [{ "$ref": "#/$defs/SessionSummaryRefV1" }, { "type": "null" }]
        },
        "recentTurns": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/TurnIndexEntryV1" }
        },
        "activeTurnId": {
          "oneOf": [{ "$ref": "#/$defs/OpaqueTurnId" }, { "type": "null" }]
        },
        "writerLease": { "$ref": "#/$defs/WriterLeaseV1" },
        "createdAtMs": { "type": "integer", "minimum": 0 },
        "updatedAtMs": { "type": "integer", "minimum": 0 },
        "terminationReason": {
          "oneOf": [
            { "enum": ["project_closed", "user_ended", "fatal_contract_error"] },
            { "type": "null" }
          ]
        }
      }
    },
    "ProjectScopedReferenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "kind", "referenceId", "contentHash"],
      "properties": {
        "projectId": { "$ref": "#/$defs/OpaqueProjectId" },
        "kind": { "enum": ["summary", "tool_result", "transaction"] },
        "referenceId": { "$ref": "#/$defs/BoundedToken" },
        "contentHash": { "$ref": "#/$defs/ContentHash" }
      }
    },
    "TurnFailureV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detailHash"],
      "properties": {
        "code": {
          "enum": [
            "provider_snapshot_drift",
            "skill_pack_snapshot_drift",
            "authorization_policy_snapshot_drift",
            "contract_violation",
            "write_recovery_required"
          ]
        },
        "detailHash": { "$ref": "#/$defs/ContentHash" }
      }
    },
    "AgentTurnV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "turnId",
        "sessionId",
        "projectId",
        "state",
        "intent",
        "selectedSkillIds",
        "frozen",
        "references",
        "cancellationRequested",
        "writeTransactionStarted",
        "failure",
        "createdAtMs",
        "updatedAtMs"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "turnId": { "$ref": "#/$defs/OpaqueTurnId" },
        "sessionId": { "$ref": "#/$defs/OpaqueSessionId" },
        "projectId": { "$ref": "#/$defs/OpaqueProjectId" },
        "state": {
          "enum": [
            "idle",
            "planning",
            "reading",
            "acting",
            "awaiting_high_risk_confirmation",
            "applying",
            "validating",
            "completed",
            "cancelled",
            "failed",
            "recovery_required"
          ]
        },
        "intent": { "enum": ["discussion", "clarification", "product_help", "project_work"] },
        "selectedSkillIds": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BoundedToken" }
        },
        "frozen": { "$ref": "#/$defs/FrozenTurnSnapshotV1" },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProjectScopedReferenceV1" }
        },
        "cancellationRequested": { "type": "boolean" },
        "writeTransactionStarted": { "type": "boolean" },
        "failure": {
          "oneOf": [{ "$ref": "#/$defs/TurnFailureV1" }, { "type": "null" }]
        },
        "createdAtMs": { "type": "integer", "minimum": 0 },
        "updatedAtMs": { "type": "integer", "minimum": 0 }
      }
    },
    "ProjectAgentBasePolicyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyId",
        "isSkill",
        "requiresProjectSession",
        "allowsBypassChat",
        "allowsZeroSkillDirectResponse",
        "allowedWithoutOpenProject"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "policyId": { "const": "project-agent-base-policy-v1" },
        "isSkill": { "const": false },
        "requiresProjectSession": { "const": true },
        "allowsBypassChat": { "const": false },
        "allowsZeroSkillDirectResponse": { "const": true },
        "allowedWithoutOpenProject": {
          "const": ["create_project", "open_project", "product_help"]
        }
      }
    }
  }
}
