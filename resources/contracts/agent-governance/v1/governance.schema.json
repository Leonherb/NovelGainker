{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelgainker.local/schemas/agent/governance-v1.json",
  "title": "NovelGainker Agent governance, persistence, transaction and undo contracts",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/TurnAuthorizationV1" },
    { "$ref": "#/$defs/HighRiskConfirmationV1" },
    { "$ref": "#/$defs/SessionPersistenceSnapshotV1" },
    { "$ref": "#/$defs/UndoCatalogV1" },
    { "$ref": "#/$defs/MultiFileTransactionPlanV1" },
    { "$ref": "#/$defs/TransactionReceiptV1" }
  ],
  "$defs": {
    "SchemaVersion": { "const": 1 },
    "ProjectId": {
      "type": "string",
      "pattern": "^prj_[A-Za-z0-9_-]{8,92}$",
      "maxLength": 96
    },
    "SessionId": {
      "type": "string",
      "pattern": "^ses_[A-Za-z0-9_-]{8,92}$",
      "maxLength": 96
    },
    "TurnId": {
      "type": "string",
      "pattern": "^trn_[A-Za-z0-9_-]{8,92}$",
      "maxLength": 96
    },
    "ContentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![A-Za-z]:[\\/])(?![\\/])(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$)).+$"
    },
    "AuthorizationPolicy": {
      "enum": ["plan_only", "review_every_write", "auto_apply_safe"]
    },
    "RiskLevel": {
      "enum": ["read-safe", "write-safe", "always-confirm", "forbidden-v1"]
    },
    "GovernedAction": {
      "enum": [
        "list_managed_markdown",
        "read_managed_markdown",
        "search_managed_markdown",
        "validate_managed_markdown",
        "create_entity_markdown",
        "patch_entity_markdown",
        "create_draft_chapter",
        "replace_whole_file",
        "replace_whole_chapter",
        "promote_chapter_state",
        "update_story_ledger",
        "modify_project_rules",
        "modify_critical_metadata",
        "import_outside_project",
        "publish_or_export",
        "delete_path",
        "move_path",
        "rename_path",
        "arbitrary_filesystem",
        "system_capability",
        "modify_authorization_or_skill_pack"
      ]
    },
    "RegisteredToolId": {
      "enum": [
        "project.list_markdown",
        "project.read_markdown",
        "project.search_markdown",
        "project.validate_markdown",
        "project.create_markdown",
        "project.patch_markdown"
      ]
    },
    "ProjectToolBindingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "sessionId", "turnId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "turnId": { "$ref": "#/$defs/TurnId" }
      }
    },
    "ValidatedMutationShapeV1": {
      "enum": [
        "create_entity_markdown",
        "create_draft_chapter",
        "patch_hunks",
        "replace_whole_file",
        "replace_whole_chapter",
        "promote_chapter_state",
        "update_story_ledger",
        "modify_project_rules",
        "modify_critical_metadata",
        "publish_or_export"
      ]
    },
    "WriteToolClassificationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "binding",
        "toolRequestHash",
        "toolId",
        "path",
        "mutationShape",
        "action",
        "risk",
        "classificationHash"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "binding": { "$ref": "#/$defs/ProjectToolBindingV1" },
        "toolRequestHash": { "$ref": "#/$defs/ContentHash" },
        "toolId": { "$ref": "#/$defs/RegisteredToolId" },
        "path": { "$ref": "#/$defs/RelativePath" },
        "mutationShape": { "$ref": "#/$defs/ValidatedMutationShapeV1" },
        "action": { "$ref": "#/$defs/GovernedAction" },
        "risk": { "$ref": "#/$defs/RiskLevel" },
        "classificationHash": { "$ref": "#/$defs/ContentHash" }
      }
    },
    "AuthorizationDecisionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "risk", "policy", "effect", "reason"],
      "properties": {
        "action": { "$ref": "#/$defs/GovernedAction" },
        "risk": { "$ref": "#/$defs/RiskLevel" },
        "policy": { "$ref": "#/$defs/AuthorizationPolicy" },
        "effect": { "enum": ["execute", "await_confirmation", "block"] },
        "reason": {
          "enum": [
            "read-safe",
            "auto-apply-safe",
            "review-every-write",
            "high-risk-confirmation",
            "plan-only-write-blocked",
            "forbidden-v1"
          ]
        }
      }
    },
    "TurnAuthorizationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policy",
        "decisions",
        "transactionEffect",
        "preconfirmationWriteCount",
        "atomicWriteTransaction"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "policy": { "$ref": "#/$defs/AuthorizationPolicy" },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 21,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AuthorizationDecisionV1" }
        },
        "transactionEffect": {
          "enum": ["execute", "await_confirmation", "block"]
        },
        "preconfirmationWriteCount": { "const": 0 },
        "atomicWriteTransaction": { "const": true }
      }
    },
    "ConfirmationBindingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "sessionId",
        "turnId",
        "actionPlanHash",
        "sourceSetHash",
        "policySnapshotHash"
      ],
      "properties": {
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "turnId": { "$ref": "#/$defs/TurnId" },
        "actionPlanHash": { "$ref": "#/$defs/ContentHash" },
        "sourceSetHash": { "$ref": "#/$defs/ContentHash" },
        "policySnapshotHash": { "$ref": "#/$defs/ContentHash" }
      }
    },
    "HighRiskConfirmationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "confirmationId",
        "authority",
        "binding",
        "issuedAtMs",
        "used",
        "confirmationHash"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "confirmationId": {
          "type": "string",
          "pattern": "^cfm_[A-Za-z0-9_-]{8,92}$",
          "maxLength": 96
        },
        "authority": { "const": "user_via_application" },
        "binding": { "$ref": "#/$defs/ConfirmationBindingV1" },
        "issuedAtMs": { "type": "integer", "minimum": 0 },
        "used": { "type": "boolean" },
        "confirmationHash": { "$ref": "#/$defs/ContentHash" }
      }
    },
    "FullChatPersistenceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "userOptIn",
        "protection",
        "maxUtf8Bytes",
        "retentionDays",
        "privacyNoticeVersion",
        "clearGeneration"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "userOptIn": { "type": "boolean" },
        "protection": { "enum": ["disabled", "windows_user_context"] },
        "maxUtf8Bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20971520
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "privacyNoticeVersion": {
          "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
        },
        "clearGeneration": { "type": "integer", "minimum": 0 }
      }
    },
    "SessionPersistenceSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "sessionId",
        "authorizationPolicy",
        "summary",
        "messageIndex",
        "terminalTurns",
        "fullChat",
        "clearGeneration"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "authorizationPolicy": { "$ref": "#/$defs/AuthorizationPolicy" },
        "summary": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "projectId",
                "sessionId",
                "summaryId",
                "version",
                "text",
                "contentHash",
                "utf8Bytes"
              ],
              "properties": {
                "projectId": { "$ref": "#/$defs/ProjectId" },
                "sessionId": { "$ref": "#/$defs/SessionId" },
                "summaryId": {
                  "type": "string",
                  "pattern": "^sum_[A-Za-z0-9_-]{8,92}$"
                },
                "version": { "type": "integer", "minimum": 1 },
                "text": { "type": "string", "minLength": 1, "maxLength": 32768 },
                "contentHash": { "$ref": "#/$defs/ContentHash" },
                "utf8Bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32768
                }
              }
            }
          ]
        },
        "messageIndex": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "object" }
        },
        "terminalTurns": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "object" }
        },
        "fullChat": { "$ref": "#/$defs/FullChatPersistenceV1" },
        "clearGeneration": { "type": "integer", "minimum": 0 }
      }
    },
    "UndoTargetV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expectedCurrentHash"],
      "properties": {
        "path": { "$ref": "#/$defs/RelativePath" },
        "expectedCurrentHash": { "$ref": "#/$defs/ContentHash" }
      }
    },
    "UndoRecordV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "sessionId",
        "turnId",
        "transactionHash",
        "blobId",
        "blobHash",
        "encryptedBytes",
        "protection",
        "targets",
        "targetSetHash",
        "createdAtMs",
        "expiresAtMs",
        "status",
        "clearGeneration"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "turnId": { "$ref": "#/$defs/TurnId" },
        "transactionHash": { "$ref": "#/$defs/ContentHash" },
        "blobId": {
          "type": "string",
          "pattern": "^ubl_[A-Za-z0-9_-]{8,92}$"
        },
        "blobHash": { "$ref": "#/$defs/ContentHash" },
        "encryptedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "protection": { "const": "windows_user_context" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/UndoTargetV1" }
        },
        "targetSetHash": { "$ref": "#/$defs/ContentHash" },
        "createdAtMs": { "type": "integer", "minimum": 0 },
        "expiresAtMs": { "type": "integer", "minimum": 0 },
        "status": {
          "enum": ["ready", "consumed", "expired", "hash_conflict", "decrypt_failed", "cleared"]
        },
        "clearGeneration": { "type": "integer", "minimum": 0 }
      }
    },
    "UndoCatalogV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "records",
        "totalEncryptedBytes",
        "clearGeneration"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "records": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/UndoRecordV1" }
        },
        "totalEncryptedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20971520
        },
        "clearGeneration": { "type": "integer", "minimum": 0 }
      }
    },
    "FrozenFileStateV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sourceHash", "targetMustBeAbsent"],
      "properties": {
        "path": { "$ref": "#/$defs/RelativePath" },
        "sourceHash": {
          "oneOf": [{ "$ref": "#/$defs/ContentHash" }, { "type": "null" }]
        },
        "targetMustBeAbsent": { "type": "boolean" }
      }
    },
    "PlannedFileMutationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen", "classification", "plannedResultHash", "estimatedUndoBytes"],
      "properties": {
        "frozen": { "$ref": "#/$defs/FrozenFileStateV1" },
        "classification": { "$ref": "#/$defs/WriteToolClassificationV1" },
        "plannedResultHash": { "$ref": "#/$defs/ContentHash" },
        "estimatedUndoBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "MultiFileTransactionPlanV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "sessionId",
        "turnId",
        "policySnapshotHash",
        "mutations",
        "sourceSetHash",
        "actionPlanHash",
        "transactionHash",
        "totalEstimatedUndoBytes"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "turnId": { "$ref": "#/$defs/TurnId" },
        "policySnapshotHash": { "$ref": "#/$defs/ContentHash" },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/PlannedFileMutationV1" }
        },
        "sourceSetHash": { "$ref": "#/$defs/ContentHash" },
        "actionPlanHash": { "$ref": "#/$defs/ContentHash" },
        "transactionHash": { "$ref": "#/$defs/ContentHash" },
        "totalEstimatedUndoBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "TransactionReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectId",
        "sessionId",
        "turnId",
        "transactionHash",
        "committedResults",
        "resultSetHash",
        "recovery",
        "committedAtMs"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/SchemaVersion" },
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "sessionId": { "$ref": "#/$defs/SessionId" },
        "turnId": { "$ref": "#/$defs/TurnId" },
        "transactionHash": { "$ref": "#/$defs/ContentHash" },
        "committedResults": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "resultHash"],
            "properties": {
              "path": { "$ref": "#/$defs/RelativePath" },
              "resultHash": { "$ref": "#/$defs/ContentHash" }
            }
          }
        },
        "resultSetHash": { "$ref": "#/$defs/ContentHash" },
        "recovery": {
          "enum": ["not_required", "rolled_back_to_source_set", "recovery_required"]
        },
        "committedAtMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
