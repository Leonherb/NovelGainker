{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelgainker.local/schemas/agent/runtime-write-action-v2.json",
  "title": "NovelGainker AM2 Governed Agent Action V2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "skillIds", "visibleText"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "respond" },
        "skillIds": { "$ref": "#/$defs/SkillIds" },
        "visibleText": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "skillIds", "toolRequests"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "request_tools" },
        "skillIds": { "$ref": "#/$defs/SkillIds" },
        "toolRequests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/ToolRequest" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "skillIds", "visibleSummary"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "complete" },
        "skillIds": { "$ref": "#/$defs/SkillIds" },
        "visibleSummary": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    }
  ],
  "$defs": {
    "SkillIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "create-novel-project",
          "create-setting",
          "create-character",
          "create-material",
          "create-plot",
          "novel-story-telling",
          "analytical-review",
          "create-visual-asset",
          "publish-novel"
        ]
      }
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ToolRequest": {
      "oneOf": [
        { "$ref": "#/$defs/ListToolRequest" },
        { "$ref": "#/$defs/ReadToolRequest" },
        { "$ref": "#/$defs/SearchToolRequest" },
        { "$ref": "#/$defs/ValidateToolRequest" },
        { "$ref": "#/$defs/CreateToolRequest" },
        { "$ref": "#/$defs/PatchToolRequest" }
      ]
    },
    "CallId": {
      "type": "string",
      "pattern": "^call_[A-Za-z0-9_-]{8,91}$"
    },
    "Purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "ListToolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "$ref": "#/$defs/CallId" },
        "toolId": { "const": "project.list_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directory"],
          "properties": { "directory": { "$ref": "#/$defs/RelativePath" } }
        },
        "purpose": { "$ref": "#/$defs/Purpose" }
      }
    },
    "ReadToolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "$ref": "#/$defs/CallId" },
        "toolId": { "const": "project.read_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "$ref": "#/$defs/RelativePath" } }
        },
        "purpose": { "$ref": "#/$defs/Purpose" }
      }
    },
    "SearchToolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "$ref": "#/$defs/CallId" },
        "toolId": { "const": "project.search_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directory", "query"],
          "properties": {
            "directory": { "$ref": "#/$defs/RelativePath" },
            "query": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "purpose": { "$ref": "#/$defs/Purpose" }
      }
    },
    "ValidateToolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "$ref": "#/$defs/CallId" },
        "toolId": { "const": "project.validate_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "$ref": "#/$defs/RelativePath" } }
        },
        "purpose": { "$ref": "#/$defs/Purpose" }
      }
    },
    "CreateToolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "$ref": "#/$defs/CallId" },
        "toolId": { "const": "project.create_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "content"],
          "properties": {
            "path": { "$ref": "#/$defs/RelativePath" },
            "content": { "type": "string", "minLength": 1, "maxLength": 65536 }
          }
        },
        "purpose": { "$ref": "#/$defs/Purpose" }
      }
    },
    "PatchToolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "$ref": "#/$defs/CallId" },
        "toolId": { "const": "project.patch_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "patch", "expectedSourceHash"],
          "properties": {
            "path": { "$ref": "#/$defs/RelativePath" },
            "patch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536,
              "description": "Strict serialized novelgainker.patch-v1 JSON envelope"
            },
            "expectedSourceHash": { "$ref": "#/$defs/ContentHash" }
          }
        },
        "purpose": { "$ref": "#/$defs/Purpose" }
      }
    }
  }
}
