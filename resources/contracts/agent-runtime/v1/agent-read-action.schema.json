{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novelgainker.local/schemas/agent/runtime-read-action-v1.json",
  "title": "NovelGainker AM1 Read-only Agent Action V1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "skillIds", "visibleText"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "respond" },
        "skillIds": { "$ref": "#/$defs/SkillIds" },
        "visibleText": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "skillIds", "toolRequests"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "request_tools" },
        "skillIds": { "$ref": "#/$defs/SkillIds" },
        "toolRequests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/ReadToolRequest" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "action", "skillIds", "visibleSummary"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "complete" },
        "skillIds": { "$ref": "#/$defs/SkillIds" },
        "visibleSummary": { "type": "string", "minLength": 1, "maxLength": 32768 }
      }
    }
  ],
  "$defs": {
    "SkillIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "create-novel-project",
          "create-setting",
          "create-character",
          "create-material",
          "create-plot",
          "novel-story-telling",
          "analytical-review",
          "create-visual-asset",
          "publish-novel"
        ]
      }
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "ReadToolRequest": {
      "oneOf": [
        { "$ref": "#/$defs/ListToolRequest" },
        { "$ref": "#/$defs/ReadToolRequestByPath" },
        { "$ref": "#/$defs/SearchToolRequest" },
        { "$ref": "#/$defs/ValidateToolRequest" }
      ]
    },
    "ListToolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "type": "string", "pattern": "^call_[A-Za-z0-9_-]{8,91}$" },
        "toolId": { "const": "project.list_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directory"],
          "properties": {
            "directory": { "$ref": "#/$defs/RelativePath" }
          }
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "ReadToolRequestByPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "type": "string", "pattern": "^call_[A-Za-z0-9_-]{8,91}$" },
        "toolId": { "const": "project.read_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "$ref": "#/$defs/RelativePath" } }
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "SearchToolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "type": "string", "pattern": "^call_[A-Za-z0-9_-]{8,91}$" },
        "toolId": { "const": "project.search_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directory", "query"],
          "properties": {
            "directory": { "$ref": "#/$defs/RelativePath" },
            "query": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "ValidateToolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "toolId", "arguments", "purpose"],
      "properties": {
        "callId": { "type": "string", "pattern": "^call_[A-Za-z0-9_-]{8,91}$" },
        "toolId": { "const": "project.validate_markdown" },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "$ref": "#/$defs/RelativePath" } }
        },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
