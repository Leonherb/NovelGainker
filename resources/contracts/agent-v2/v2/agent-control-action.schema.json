{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelgainker://contracts/agent-v2/v2/agent-control-action.schema.json",
  "title": "AgentControlActionV2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "action", "selectedSkillIds", "visibleReason", "queries"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "requestId": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,80}$" },
        "action": { "const": "request_context" },
        "selectedSkillIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "visibleReason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "terms", "knownEntityIds", "knownSourceIds", "purpose"],
            "properties": {
              "kind": {
                "enum": [
                  "entity_or_rule",
                  "relationship",
                  "plot_thread",
                  "chapter_or_scene",
                  "timeline",
                  "clue_or_material",
                  "full_text",
                  "marked_context",
                  "skill_resource"
                ]
              },
              "terms": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": { "type": "string", "minLength": 1, "maxLength": 128 }
              },
              "knownEntityIds": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{7,80}$" }
              },
              "knownSourceIds": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^src_[A-Za-z0-9_-]{8,80}$" }
              },
              "purpose": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "action",
        "selectedSkillIds",
        "visibleReason",
        "responseBrief",
        "sourceIds",
        "markSuggestions"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "requestId": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,80}$" },
        "action": { "const": "start_response" },
        "selectedSkillIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "visibleReason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "responseBrief": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sourceIds": {
          "type": "array",
          "maxItems": 48,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^src_[A-Za-z0-9_-]{8,80}$" }
        },
        "markSuggestions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId", "reason"],
            "properties": {
              "sourceId": { "type": "string", "pattern": "^src_[A-Za-z0-9_-]{8,80}$" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "action",
        "selectedSkillIds",
        "visibleReason",
        "targetKind",
        "displayName",
        "proposalBrief",
        "sourceIds"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "requestId": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,80}$" },
        "action": { "const": "submit_canon_proposal" },
        "selectedSkillIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "visibleReason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "targetKind": { "enum": ["character", "setting", "material", "plot", "chapter"] },
        "displayName": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
        "proposalBrief": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "sourceIds": {
          "type": "array",
          "maxItems": 48,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^src_[A-Za-z0-9_-]{8,80}$" }
        }
      }
    }
  ]
}
