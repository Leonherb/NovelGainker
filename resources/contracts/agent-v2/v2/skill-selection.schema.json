{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelgainker://contracts/agent-v2/v2/skill-selection.schema.json",
  "title": "SkillSelectionV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "selectedSkillIds", "intentClass", "visibleReason"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "requestId": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,80}$" },
    "selectedSkillIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "create-novel-project",
          "create-setting",
          "create-character",
          "create-material",
          "create-plot",
          "novel-story-telling",
          "analytical-review",
          "create-visual-asset",
          "publish-novel"
        ]
      }
    },
    "intentClass": {
      "enum": [
        "product_help",
        "project_discussion",
        "canon_update",
        "composition",
        "revision",
        "review",
        "visual",
        "publish"
      ]
    },
    "visibleReason": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}

