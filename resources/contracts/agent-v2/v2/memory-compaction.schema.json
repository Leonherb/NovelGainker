{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novelgainker://contracts/agent-v2/v2/memory-compaction.schema.json",
  "title": "MemoryCompactionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "baseMemoryHash",
    "summaryText",
    "compactedThroughTurnId"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,80}$" },
    "baseMemoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summaryText": { "type": "string", "minLength": 1, "maxLength": 16000 },
    "compactedThroughTurnId": {
      "type": "string",
      "pattern": "^trn_[A-Za-z0-9_-]{8,80}$"
    }
  }
}

