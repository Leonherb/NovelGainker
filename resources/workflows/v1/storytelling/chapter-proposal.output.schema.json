{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.novelgainker.local/workflows/chapter-proposal-payload.v1.json",
  "title": "ChapterProposalPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "draftMarkdown",
    "intentSummary",
    "readerModelDelta",
    "continuityClaims",
    "ledgerCandidates"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "draftMarkdown": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "intentSummary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "readerModelDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readerKnows",
        "readerInfers",
        "readerMisreads",
        "readerQuestions",
        "chapterPromises",
        "forbiddenReveals"
      ],
      "properties": {
        "readerKnows": { "type": "string", "maxLength": 4096 },
        "readerInfers": { "type": "string", "maxLength": 4096 },
        "readerMisreads": { "type": "string", "maxLength": 4096 },
        "readerQuestions": { "type": "string", "maxLength": 4096 },
        "chapterPromises": { "type": "string", "maxLength": 4096 },
        "forbiddenReveals": { "type": "string", "maxLength": 4096 }
      }
    },
    "continuityClaims": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "sourceIds"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "sourceIds": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "ledgerCandidates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "sourceIds"],
        "properties": {
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "sourceIds": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    }
  }
}
