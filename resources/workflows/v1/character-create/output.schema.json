{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.novelgainker.local/workflows/character-proposal.v2.json",
  "title": "CharacterProposalV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "character",
    "rationale"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "workflowId": {
      "type": "string",
      "const": "novelgainker.character-create"
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "role",
        "summary",
        "traits",
        "goal",
        "conflict",
        "motivations",
        "secrets",
        "plotFunctions",
        "relationships"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "traits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "conflict": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "motivations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "secrets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "plotFunctions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "relationships": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetId",
              "relationType",
              "description"
            ],
            "properties": {
              "targetId": {
                "type": "string",
                "minLength": 41,
                "maxLength": 46
              },
              "relationType": {
                "type": "string",
                "enum": [
                  "ally",
                  "rival",
                  "family",
                  "mentor",
                  "romantic",
                  "subordinate",
                  "associated_with"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
