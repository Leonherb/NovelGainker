{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.novelgainker.local/workflows/character-brief.v2.json",
  "title": "CharacterBriefV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "brief"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "mode": {
      "type": "string",
      "enum": [
        "create",
        "enhance"
      ]
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
