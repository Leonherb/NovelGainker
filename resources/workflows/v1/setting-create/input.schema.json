{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.novelgainker.local/workflows/setting-brief.v1.json",
  "title": "SettingBriefV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "displayName",
    "settingType",
    "objective",
    "mustInclude",
    "constraints"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "settingType": {
      "type": "string",
      "enum": ["world", "location", "rule"]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "mustInclude": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "constraints": {
      "type": ["string", "null"],
      "maxLength": 1000
    }
  }
}
