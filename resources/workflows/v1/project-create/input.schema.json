{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.novelgainker.local/workflows/project-create-input.v1.json",
  "title": "NovelGainker ProjectCreateInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "authorDisplayName", "genre", "premise"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "authorDisplayName": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "genre": {
      "type": ["string", "null"],
      "maxLength": 80
    },
    "premise": {
      "type": ["string", "null"],
      "maxLength": 300
    }
  }
}
