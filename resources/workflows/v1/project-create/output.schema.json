{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.novelgainker.local/workflows/project-scaffold-preview.v1.json",
  "title": "NovelGainker ProjectScaffoldPreviewV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "previewHash",
    "projectId",
    "writingLanguage",
    "workflowPackVersion",
    "defaultProviderId",
    "existingUnrelatedEntryCount",
    "directories",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "previewHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "writingLanguage": {
      "type": "string",
      "const": "zh-CN"
    },
    "workflowPackVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "defaultProviderId": {
      "type": "string",
      "const": "openai"
    },
    "existingUnrelatedEntryCount": {
      "type": "integer",
      "minimum": 0
    },
    "directories": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relativePath", "byteLength", "contentSha256", "content"],
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "byteLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65536
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content": {
            "type": "string",
            "maxLength": 65536
          }
        }
      }
    }
  }
}
