{
  "schemaVersion": 1,
  "workflowPackVersion": "1.0.0",
  "workflows": [
    {
      "id": "novelgainker.character-create",
      "version": 2,
      "displayName": "创建/完善人物",
      "description": "审查显式选择的 Canon 来源，创建或完善单个人物 Markdown，并保留稳定实体引用。",
      "mode": "interactive-write",
      "executionAvailable": true,
      "routable": true,
      "allowedTools": ["source.create_character"],
      "requiredConfirmations": ["send_context", "create_or_replace_character_file"],
      "inputSchemaVersion": 2,
      "outputSchemaVersion": 2,
      "workflowResource": "character-create/workflow.md",
      "inputSchema": "character-create/input.schema.json",
      "outputSchema": "character-create/output.schema.json",
      "templateResource": "character-create/character.template.md"
    },
    {
      "id": "novelgainker.project-create",
      "version": 1,
      "displayName": "创建项目",
      "description": "离线填写项目元数据，安全审查完整脚手架后创建本地 Markdown 小说项目。",
      "mode": "deterministic-write",
      "executionAvailable": true,
      "routable": true,
      "allowedTools": ["project.scan", "project.create"],
      "requiredConfirmations": ["create_project_scaffold"],
      "inputSchemaVersion": 1,
      "outputSchemaVersion": 1,
      "workflowResource": "project-create/workflow.md",
      "inputSchema": "project-create/input.schema.json",
      "outputSchema": "project-create/output.schema.json",
      "templateResource": "project-create/project.template.md"
    },
    {
      "id": "novelgainker.setting-create",
      "version": 1,
      "displayName": "创建设定",
      "description": "审查显式选择的世界资料，生成结构化设定提案，经确认后写入一个 world Markdown。",
      "mode": "interactive-write",
      "executionAvailable": true,
      "routable": true,
      "allowedTools": ["source.create_setting"],
      "requiredConfirmations": ["send_context", "create_setting_file"],
      "inputSchemaVersion": 1,
      "outputSchemaVersion": 1,
      "workflowResource": "setting-create/workflow.md",
      "inputSchema": "setting-create/input.schema.json",
      "outputSchema": "setting-create/output.schema.json",
      "templateResource": "setting-create/setting.template.md"
    },
    {
      "id": "novelgainker.material-create",
      "version": 1,
      "displayName": "创建素材",
      "description": "审查显式选择的 Canon 来源，生成结构化素材提案，经确认后写入一个普通 materials Markdown。",
      "mode": "interactive-write",
      "executionAvailable": true,
      "routable": true,
      "allowedTools": ["source.create_material"],
      "requiredConfirmations": ["send_context", "promote_material_to_canon"],
      "inputSchemaVersion": 1,
      "outputSchemaVersion": 1,
      "workflowResource": "material-create/workflow.md",
      "inputSchema": "material-create/input.schema.json",
      "outputSchema": "material-create/output.schema.json",
      "templateResource": "material-create/material.template.md"
    },
    {
      "id": "novelgainker.plot-create",
      "version": 1,
      "displayName": "创建主剧情",
      "description": "审查显式选择的人物、设定和普通素材，生成结构化主剧情提案，经确认后写入固定 plot/main.md。",
      "mode": "interactive-write",
      "executionAvailable": true,
      "routable": true,
      "allowedTools": ["source.create_plot"],
      "requiredConfirmations": ["send_context", "create_or_replace_main_plot"],
      "inputSchemaVersion": 1,
      "outputSchemaVersion": 1,
      "workflowResource": "plot-create/workflow.md",
      "inputSchema": "plot-create/input.schema.json",
      "outputSchema": "plot-create/output.schema.json",
      "templateResource": "plot-create/plot.template.md"
    },
    {
      "id": "novelgainker.storytelling",
      "version": 1,
      "displayName": "小说续写与章节创作",
      "description": "审查确定性 Context Manifest；本阶段只构建上下文，不调用 Provider 或写入章节。",
      "mode": "interactive-write",
      "executionAvailable": false,
      "routable": false,
      "allowedTools": ["story.build_context"],
      "requiredConfirmations": ["select_context"],
      "inputSchemaVersion": 2,
      "outputSchemaVersion": 2,
      "workflowResource": "storytelling/workflow.md",
      "inputSchema": "storytelling/input.schema.json",
      "outputSchema": "storytelling/output.schema.json",
      "templateResource": "storytelling/chapter.template.md"
    }
  ]
}
