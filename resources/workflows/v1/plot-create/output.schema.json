{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.novelgainker.local/workflows/plot-proposal.v1.json",
  "title": "PlotProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plot", "schemaVersion", "workflowId"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "workflowId": { "type": "string", "const": "novelgainker.plot-create" },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openQuestions", "payoffs", "pressure", "promise", "reveals", "title", "turns"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "promise": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "pressure": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "turns": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "reveals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "payoffs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "openQuestions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
