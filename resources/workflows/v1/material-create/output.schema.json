{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.novelgainker.local/workflows/material-proposal.v1.json",
  "title": "MaterialProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["material", "schemaVersion", "workflowId"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "workflowId": { "type": "string", "const": "novelgainker.material-create" },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonReason", "content", "displayName", "intendedUse", "materialType", "summary"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "materialType": { "type": "string", "enum": ["theme", "clue", "object", "scene_seed"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 800 },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "intendedUse": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "canonReason": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
