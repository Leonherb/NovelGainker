{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.novelgainker.local/workflows/material-brief.v1.json",
  "title": "MaterialBriefV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["constraints", "displayName", "intendedUse", "materialType", "schemaVersion", "seed"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "materialType": { "type": "string", "enum": ["theme", "clue", "object", "scene_seed"] },
    "seed": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "intendedUse": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "constraints": { "type": ["string", "null"], "maxLength": 1000 }
  }
}
